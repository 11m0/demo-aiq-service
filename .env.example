# Application
APP_ENV=local
LOG_LEVEL=INFO
API_MAX_REQUEST_BYTES=1048576
# Required whenever LLM enables /v1; use 32-512 Bearer-safe ASCII characters.
SERVICE_AUTH_TOKEN=
# Accept the old token here only during an overlap rotation, then remove it.
SERVICE_AUTH_PREVIOUS_TOKEN=

# Browser-facing backend. The same SERVICE_AUTH_TOKEN is used only server-side.
ML_TURN_URL=http://127.0.0.1:8000/v1/turns/process
# Учитывайте три последовательных вызова LLM: основной, исправление и проверку выбора.
# Значение должно быть больше 3 * LLM_TIMEOUT_SECONDS; 200 покрывает 3 * 60 + 20 секунд.
ML_TIMEOUT_SECONDS=200
ML_RESPONSE_MAX_BYTES=262144
BACKEND_MAX_REQUEST_BYTES=16384
BACKEND_SESSION_TTL_SECONDS=3600
BACKEND_MAX_SESSIONS=1000

# OpenAI Responses-compatible endpoint with JSON Schema structured output.
# Base URL is optional for the standard OpenAI API.
# Leave key, model and base URL empty only for local health-only mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.0
